{
  "manifest_version": 3,
  "name": "dotStart",
  "version": "2.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["search", "tabs", "bookmarks", "history"],
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "256": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dotstart@amexe2.github.io",
      "strict_min_version": "109.0"
    }
  }
}
