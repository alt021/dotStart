{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["search"],
  "optional_permissions": ["bookmarks", "history"],
  "icons": {
    "16": "icon-16.png",
