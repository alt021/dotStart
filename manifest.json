    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dotstart@amexe2.github.io",
      "strict_min_version": "109.0"
    }
  }
}
